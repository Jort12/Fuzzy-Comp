{
    "mode": "prod",
    "rules": [
        {
        "name": "CRITICAL_EVASION_RIGHT",
        "antecedents": [
            { "var": "ttc", "mf": "imminent" },
            { "var": "threat_angle", "mf": "right_side" },
            { "var": "dist", "mf": "very_close" }
        ],
        "consequents": {
            "thrust": { "type": "constant", "value": 30 },
            "turn_rate": { "type": "constant", "value": -180 }
        },
        "weight": 2.0
        },

        {
