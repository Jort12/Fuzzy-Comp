{
  "mode": "prod",
  "profiles": {
    "critical_evasion": {
      "weight": 2.0,
      "out": {
        "thrust": {
          "type": "constant",
          "value": 30
        },
        "turn_rate": {
          "type": "conditional",
          "if": {
            "var": "threat_angle",
            "op": ">",
            "value": 0.0
          },
          "then": 180,
          "else": -180
        }
      }
    },
    "approach_dist": {
      "weight": 1.8,
      "out": {
        "thrust": {
          "type": "constant",
          "value": 40
        },
        "turn_rate": {
          "type": "conditional",
          "if": {
            "var": "threat_angle",
            "op": ">",
            "value": 0.0
          },
          "then": 180,
          "else": -180
        }
      }
    },
    "ttc_angle": {
      "weight": 1.5,
      "out": {
        "thrust": {
          "type": "constant",
          "value": 60
        },
        "turn_rate": {
          "type": "constant",
          "value": 150
        }
      }
    },
    "density_dist": {
      "weight": 1.3,
      "out": {
        "thrust": {
          "type": "constant",
          "value": 80
        },
        "turn_rate": {
          "type": "conditional",
          "if": {
            "var": "threat_angle",
            "op": ">",
            "value": 0.0
          },
          "then": 180,
          "else": -180
        }
      }
    },
    "density_only": {
      "weight": 1.0,
      "out": {
        "thrust": {
          "type": "constant",
          "value": 100
        },
        "turn_rate": {
          "type": "linear",
          "bias": 0.0,
          "weights": {
            "escape_x": 120.0
          }
        }
      }
    },
    "dist_ttc": {
      "weight": 0.3,
      "out": {
        "thrust": {
          "type": "expr",
          "expression": "100 + 40 * dist_norm"
        },
        "turn_rate": {
          "type": "constant",
          "value": 0.0
        }
      }
    },
    "heading_dist_ttc": {
      "weight": 0.5,
      "out": {
        "thrust": {
          "type": "expr",
          "expression": "80 + 40 * dist_norm"
        },
        "turn_rate": {
          "type": "expr",
          "expression": "K_TURN * 90 * heading_norm"
        }
      }
    },
    "default_dist": {
      "weight": 0.2,
      "out": {
        "thrust": {
          "type": "expr",
          "expression": "60 + 20 * dist_norm"
        },
        "turn_rate": {
          "type": "constant",
          "value": 0.0
        }
      }
    }
  },
